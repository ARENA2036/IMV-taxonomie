{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Industrial Metaverse Technology Profile",
  "description": "Canonical schema definition for tool and technology profiles across the ARENA2036 5-layer tech stack.",
  "type": "object",
  "required": [
    "refCode",
    "categoryCode",
    "categoryName",
    "name",
    "subtitle",
    "vendor",
    "hq",
    "businessModel",
    "url",
    "tier",
    "costLabel",
    "status",
    "overview",
    "features",
    "inputs",
    "outputs",
    "bridges",
    "evaluations",
    "compliance",
    "deployment",
    "staffing"
  ],
  "properties": {
    "refCode": {
      "type": "string",
      "pattern": "^IND-META-2026-[A-Z0-9-]+$",
      "description": "Unique uppercase reference code (e.g. IND-META-2026-FARO-ORBIS)."
    },
    "categoryCode": {
      "type": "string",
      "pattern": "^[1-5]\\.[1-8]$",
      "description": "Decimal category code representing Layer.Category (1.1 to 5.2)."
    },
    "categoryName": {
      "type": "string",
      "description": "Canonical name of the decimal category."
    },
    "name": {
      "type": "string",
      "description": "Full commercial or open-source name of the tool or protocol."
    },
    "subtitle": {
      "type": "string",
      "description": "Concise German technical subtitle."
    },
    "vendor": {
      "type": "string",
      "description": "Vendor, consortium, foundation or creator entity."
    },
    "hq": {
      "type": "string",
      "description": "Geographical location or country of origin."
    },
    "businessModel": {
      "type": "string",
      "description": "Commercial, Subscription, Open Source, or Hybrid."
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Official documentation or product URL."
    },
    "tier": {
      "type": "string",
      "enum": ["Tier 1", "Tier 2", "Tier 3"],
      "description": "Investment class tier (Tier 1, Tier 2, Tier 3)."
    },
    "costLabel": {
      "type": "string",
      "description": "Indicative budget bracket (e.g. ≤ €30k, ≤ €100k, > €100k)."
    },
    "status": {
      "type": "string",
      "enum": ["INDEXIERT", "GEPRÜFT", "USE CASE IMPLEMENTIERT", "EXTERN VALIDIERT", "COMMUNITY BEITRAG"],
      "description": "Taxonomy validation status."
    },
    "overview": {
      "type": "string",
      "description": "Comprehensive technical description in German."
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "desc"],
        "properties": {
          "title": { "type": "string" },
          "desc": { "type": "string" }
        }
      },
      "description": "Key technical capability features."
    },
    "inputs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Supported input formats and protocols."
    },
    "outputs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Supported output formats and protocols."
    },
    "bridges": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Native connectors and ecosystem bridges."
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "text"],
        "properties": {
          "title": { "type": "string" },
          "text": { "type": "string" }
        }
      },
      "description": "Field evaluation assessments."
    },
    "compliance": {
      "type": "object",
      "required": ["omniverse", "sovereignty", "openStandard"],
      "properties": {
        "omniverse": { "type": "string" },
        "sovereignty": { "type": "string" },
        "openStandard": { "type": "string" }
      }
    },
    "deployment": {
      "type": "object",
      "required": ["effort", "mode", "maturity", "area"],
      "properties": {
        "effort": { "type": "string" },
        "mode": { "type": "string" },
        "maturity": { "type": "string" },
        "area": { "type": "string" }
      }
    },
    "staffing": {
      "type": "string",
      "description": "Recommended team profile and engineering capacity."
    }
  },
  "additionalProperties": true
}
